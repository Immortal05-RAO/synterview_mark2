ENVIRONMENT=development

PORT=5000

# SQLite for local dev; PostgreSQL connection string for cloud deployment
DATABASE_URL=sqlite:///./synterview.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# AI Provider: openai, gemini, or fallback
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# Speech Provider: openai, local (whisper) or fallback. SPEECH_API_KEY defaults to AI_API_KEY when AI_PROVIDER=openai
SPEECH_PROVIDER=openai
SPEECH_API_KEY=
MAX_UPLOAD_MB=25

# Comma-separated frontend origins in production (e.g. https://app.vercel.app)
CORS_ORIGIN=*
DEMO_MODE=false
